# Copy to .env for local work. .env is gitignored; never commit real values.
# Every variable here is optional unless marked required.

# --- C CLI ---------------------------------------------------------------
# Bench binary discovery order: --bench, BROWNNOTE_BENCH, vendor path.
BROWNNOTE_BENCH=vendor/GuitarPedal/Validation/bench/bench
# Alternate CLI path used by the native app for catalog and renders.
BROWNNOTE_BIN=build/brownnote
# Content-addressed pedal render cache (native app).
BROWNNOTE_CACHE=
# error | warn | info | debug (default: warn)
BROWNNOTE_LOG=warn
# Attach one correlation id to every log line and the bench child.
BROWNNOTE_TRACE_ID=
# Print a JSON phase-timing summary when the CLI exits.
BROWNNOTE_PROFILE=0
# Comma-separated feature flags, e.g. name=on,other=off.
BROWNNOTE_FLAGS=

# --- Native (Rust) -------------------------------------------------------
# Fail instead of skipping when the bench is missing (CI uses this).
BROWNNOTE_REQUIRE_BENCH=0
BROWNNOTE_REQUIRE_CLAP=
BROWNNOTE_CLAP_HELPER=
BROWNNOTE_CLAP_FAULT_FIXTURE=
BROWNNOTE_REQUIRE_LADSPA=
BROWNNOTE_LADSPA_HELPER=
BROWNNOTE_LADSPA_FIXTURE=

# --- SoundCraft adapter (opt-in real-app gate) ---------------------------
# `make native-soundcraft-test` runs five pinned-app tests that launch the
# checksum-verified SoundCraft GUI with `--no-audio --control 0`. They are
# skipped unless RUN_PINNED is exactly 1. Point APP and CLI at the binaries of
# the release pinned in native/src/adapters/soundcraft/pin.json; the tests
# reject any other build by SHA-256. Use absolute paths.
BROWNNOTE_SOUNDCRAFT_RUN_PINNED=0
# SoundCraft.app/Contents/MacOS/SoundCraft from the pinned release.
BROWNNOTE_SOUNDCRAFT_APP=
# soundcraft-cli from the same pinned release.
BROWNNOTE_SOUNDCRAFT_CLI=
# Python interpreter with the #95 spike requirements (mido, soundfile).
BROWNNOTE_SOUNDCRAFT_PYTHON=
# Optional evidence destinations. Each one receives the JSON record printed by
# the corresponding test; leave unset to write into the test's scratch dir.
# #95 recipe plus adapter edit/save/reopen/relocation.
BROWNNOTE_SOUNDCRAFT_EVIDENCE=
# Real-app edit, move, delete, save, quit, reopen and relocation record.
BROWNNOTE_SOUNDCRAFT_EDIT_EVIDENCE=
# Manifest v3 live-take and retained-audio record.
BROWNNOTE_SOUNDCRAFT_LIVE_EVIDENCE=
# Track and clip identity persistence record.
BROWNNOTE_SOUNDCRAFT_NAMES_EVIDENCE=

# --- Studio (Python) -----------------------------------------------------
STUDIO_PORT=8765
STUDIO_HOST=127.0.0.1
STUDIO_ALLOW_REMOTE=0
# error | warn | info | debug (default: info)
STUDIO_LOG_LEVEL=info
# Comma-separated feature flags, e.g. jam=off.
STUDIO_FEATURES=
# Opt-in local feature-usage events, written under build/analytics/.
STUDIO_ANALYTICS=0
